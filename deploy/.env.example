# Copia este archivo a ".env" y cambia los valores.
#   cp .env.example .env

# Contrasena del usuario 'sa' de SQL Server.
# Requisito: 8+ caracteres con mayuscula, minuscula, numero y simbolo.
SA_PASSWORD=Cambia_Esta_Clave_123!

# Clave para firmar los tokens JWT.
# IMPORTANTE: minimo 32 caracteres (256 bits) o el login falla con HS256.
JWT_KEY=FitConnectPro2026SuperSecretKey!@#$%^&*()
